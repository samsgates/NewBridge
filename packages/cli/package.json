{
  "name": "@newbridge/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@newbridge/sdk": "0.1.0",
    "@newbridge/schema": "0.1.0",
    "@newbridge/emulator": "0.1.0",
    "commander": "^13.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "@newbridge/gateway": "0.1.0",
    "@newbridge/events": "0.1.0"
  },
  "bin": {
    "newbridge": "./dist/index.js"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/newbridge.git"
  },
  "homepage": "https://github.com/your-org/newbridge#readme",
  "bugs": {
    "url": "https://github.com/your-org/newbridge/issues"
  }
}
