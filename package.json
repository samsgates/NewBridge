{
  "name": "newbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source integration runtime for ServiceNow",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "node scripts/build.mjs --typecheck",
    "clean": "node scripts/clean.mjs",
    "dev:gateway": "npm run dev -w @newbridge/gateway",
    "dev:emulator": "npm run dev -w @newbridge/emulator",
    "cli": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "@types/pg": "^8.11.10"
  }
}
